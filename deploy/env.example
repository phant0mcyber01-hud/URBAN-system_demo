# URBAN platform on a server. Copy to /opt/urban/.env, mode 600.
# UI and API: only for nginx on this machine
HOST=127.0.0.1
PORT=8080
# device listener: reachable from the junctions; the name goes on its certificate (python -m urban.provision --host ...)
DEVICE_HOST=0.0.0.0
DEVICE_PORT=8443
DEVICE_NAME=urban.example.uz
# days of queue and device-health samples to keep (the audit log and the commands are kept forever)
HISTORY_DAYS=90
# field: real URBAN Edge units, no simulation. simulation: SUMO and the demo fleet (for a demo server)
URBAN_SOURCE=field
# map area, west,south,east,north (central Fergana)
BBOX=71.770,40.372,71.800,40.398
