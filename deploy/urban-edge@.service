# One URBAN Edge unit on its computer in the cabinet:  systemctl enable --now urban-edge@edge-J-21
# Its key, ca.pem and gateway.pub live in /etc/urban/pki; parameters in /etc/urban/edge-<id>.env (see deploy/README.md).
[Unit]
Description=URBAN Edge unit %i
# no wait for the network: the unit starts at once and keeps trying the platform on its own (the controller link
# and the leases run without it)
After=network.target

[Service]
User=urban
Group=urban
WorkingDirectory=/opt/urban
EnvironmentFile=/etc/urban/edge-%i.env
# the env file is data the unit's own user can write: it must not be a way to inject code into the interpreter or
# the loader (python -I below ignores PYTHON* as well)
UnsetEnvironment=PYTHONPATH PYTHONHOME LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH OPENSSL_CONF OPENSSL_MODULES
ExecStart=/opt/urban/.venv/bin/python -I -m urban.edge --unit %i --platform ${PLATFORM} --server-name ${SERVER_NAME} \
    --adapter ${ADAPTER} --controller "${CONTROLLER}" --sensors "${SENSORS}" --temp "${TEMP_SENSOR}" --door "${DOOR_SENSOR}" \
    --pki /etc/urban/pki $EXTRA
Restart=always
RestartSec=2
# The sandbox: a hacked unit service reaches its own key folder, the update inbox, the network and the controller's port, nothing
# else. No maintenance keys, no staged update bundles (the inbox holds only what the root helper has yet to check), no boot files, no other process, no privilege, no new code in memory.
NoNewPrivileges=yes
ProtectSystem=strict
# its key folder, and the update inbox (OTA updates: it downloads a package there and writes request.json;
# the root helper urban-update.service installs it only after its own checks). The "-" keeps a server install
# without the inbox working.
ReadWritePaths=/etc/urban/pki -/var/lib/urban/update-inbox
InaccessiblePaths=-/var/lib/urban/ssh -/var/lib/urban/update -/var/lib/urban/rauc -/var/lib/urban/platform -/boot
ProtectHome=yes
PrivateTmp=yes
# controllers on a serial line or a GPIO relay board: those devices only (and the group that owns serial ports);
# and the TPM's resource manager, through which the unit signs with its device key (the key never leaves the chip;
# group tss owns /dev/tpmrm0, os/rootfs/etc/udev/rules.d/60-urban-tpm.rules). A machine without a TPM has no such
# device and the line does nothing. tpm2-tools keep their scratch files in the private /tmp above.
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyS rw
DeviceAllow=char-gpiochip rw
DeviceAllow=/dev/tpmrm0 rw
SupplementaryGroups=dialout tss
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
