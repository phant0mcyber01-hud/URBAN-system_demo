# One URBAN Edge unit on its computer in the cabinet:  systemctl enable --now urban-edge@edge-J-21
# Its key, ca.pem and gateway.pub live in /etc/urban/pki; parameters in /etc/urban/edge-<id>.env (see deploy/README.md).
[Unit]
Description=URBAN Edge unit %i
# no wait for the network: the unit starts at once and keeps trying the platform on its own (the controller link
# and the leases run without it)
After=network.target

[Service]
User=urban
Group=urban
WorkingDirectory=/opt/urban
EnvironmentFile=/etc/urban/edge-%i.env
ExecStart=/opt/urban/.venv/bin/python -m urban.edge --unit %i --platform ${PLATFORM} --server-name ${SERVER_NAME} \
    --adapter ${ADAPTER} --controller "${CONTROLLER}" --sensors "${SENSORS}" --temp "${TEMP_SENSOR}" --door "${DOOR_SENSOR}" \
    --pki /etc/urban/pki $EXTRA
Restart=always
RestartSec=2
# The sandbox: a hacked unit service reaches its own key folder, the network and the controller's port, nothing
# else. No maintenance keys, no update bundles, no boot files, no other process, no privilege, no new code in memory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/urban/pki
InaccessiblePaths=-/var/lib/urban/ssh -/var/lib/urban/update -/var/lib/urban/rauc -/var/lib/urban/platform -/boot
ProtectHome=yes
PrivateTmp=yes
# controllers on a serial line or a GPIO relay board: those devices only (and the group that owns serial ports)
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyS rw
DeviceAllow=char-gpiochip rw
SupplementaryGroups=dialout
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
