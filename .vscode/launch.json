{
  // Run and debug (F5, or the "Run and Debug" panel on the left).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ URBAN: платформа",
      "type": "debugpy",
      "request": "launch",
      "module": "urban",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "▶ URBAN: демо-двойник",
      "type": "debugpy",
      "request": "launch",
      "module": "urban",
      "args": ["--demo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "▶ URBAN: демо без демо-блоков",
      "type": "debugpy",
      "request": "launch",
      "module": "urban",
      "args": ["--demo"],
      "cwd": "${workspaceFolder}",
      "env": { "URBAN_EDGE": "manual" },
      "console": "integratedTerminal"
    },
    {
      "name": "▶ URBAN: демо-блоки отдельно",
      "type": "debugpy",
      "request": "launch",
      "module": "urban.edge",
      "args": ["--keep-running"],
      "cwd": "${workspaceFolder}",
      "env": { "URBAN_SOURCE": "simulation" },
      "console": "integratedTerminal"
    },
    {
      "name": "▶ URBAN: тесты",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "▶ URBAN: демо и блоки (два процесса)",
      "configurations": ["▶ URBAN: демо без демо-блоков", "▶ URBAN: демо-блоки отдельно"],
      "stopAll": true
    }
  ]
}
