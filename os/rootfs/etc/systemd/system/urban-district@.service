# The district server's own link to the control centre (ROLE=district, also the pilot's district,center):
# it reports the queues its cameras measure and what its relay is doing, and keeps the reports through an
# outage. Started by urban-prepare once the district's kit is in place (urban-unit setup). On the pilot (district,center)
# it is the machine's own district, district-<name>, whose kit urban-prepare puts in place by itself: it reports to the
# centre over the loopback, with UPDATES=off in its env file (the machine's system is the centre's; urban/node/pilot.py).
# Without UPDATES (every separate district) the argument is empty, which is on.
[Unit]
Description=URBAN district server: its reports to the control centre
After=network.target urban-prepare.service

[Service]
User=urban
Group=urban
WorkingDirectory=/opt/urban
EnvironmentFile=/etc/urban/edge-%i.env
# the env file is data the unit's own user can write: it must not be a way to inject code into the interpreter or
# the loader (python -I below ignores PYTHON* as well)
UnsetEnvironment=PYTHONPATH PYTHONHOME LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH OPENSSL_CONF OPENSSL_MODULES
ExecStart=/opt/urban/.venv/bin/python -I -m urban.node.district --unit %i --platform ${PLATFORM} --server-name ${SERVER_NAME} \
    --pki /etc/urban/pki --sensors "${SENSORS}" --relay /run/urban/relay.json --temp "${TEMP_SENSOR}" --updates "${UPDATES}"
Restart=always
RestartSec=2
# The sandbox: its own key folder, the update inbox, the tunnel inbox and the network, nothing else (as urban-edge@)
NoNewPrivileges=yes
ProtectSystem=strict
# its key folder, the update inbox (OTA updates: it downloads a package there and writes request.json;
# the root helper urban-update.service installs it only after its own checks) and the tunnel inbox (the centre's
# signed peer list for the WireGuard tunnel to its units: the root helper urban-wg checks it again before it applies
# it). The "-" keeps a server install without the inboxes working.
ReadWritePaths=/etc/urban/pki -/var/lib/urban/update-inbox -/var/lib/urban/wg-inbox
InaccessiblePaths=-/var/lib/urban/ssh -/var/lib/urban/update -/var/lib/urban/rauc -/var/lib/urban/platform -/boot -/var/lib/urban/wg
ProtectHome=yes
PrivateTmp=yes
# no devices at all but the TPM's resource manager, through which the district signs with its device key (the key
# never leaves the chip; group tss owns /dev/tpmrm0, os/rootfs/etc/udev/rules.d/60-urban-tpm.rules). This replaces
# PrivateDevices=yes, which would hide /dev/tpmrm0: DevicePolicy=closed keeps every other device shut. Without a TPM
# the line does nothing. tpm2-tools keep their scratch files in the private /tmp above.
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
SupplementaryGroups=tss
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
