# The district server's own link to the control centre (ROLE=district, also the pilot's district,center):
# it reports the queues its cameras measure and what its relay is doing, and keeps the reports through an
# outage. Started by urban-prepare once the district's kit is in place (urban-unit setup).
[Unit]
Description=URBAN district server: its reports to the control centre
After=network.target urban-prepare.service

[Service]
User=urban
Group=urban
WorkingDirectory=/opt/urban
EnvironmentFile=/etc/urban/edge-%i.env
ExecStart=/opt/urban/.venv/bin/python -m urban.node.district --unit %i --platform ${PLATFORM} --server-name ${SERVER_NAME} \
    --pki /etc/urban/pki --sensors "${SENSORS}" --relay /run/urban/relay.json --temp "${TEMP_SENSOR}"
Restart=always
RestartSec=2
# The sandbox: its own key folder, the update inbox and the network, nothing else (as urban-edge@)
NoNewPrivileges=yes
ProtectSystem=strict
# its key folder, and the update inbox (OTA updates: it downloads a package there and writes request.json;
# the root helper urban-update.service installs it only after its own checks). The "-" keeps a server install
# without the inbox working.
ReadWritePaths=/etc/urban/pki -/var/lib/urban/update-inbox
InaccessiblePaths=-/var/lib/urban/ssh -/var/lib/urban/update -/var/lib/urban/rauc -/var/lib/urban/platform -/boot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
