# The control centre on URBAN OS (roles center and district,center): started by urban-prepare, settings in
# /var/lib/urban/etc/platform.env, data (city, keys, accounts, history) in /var/lib/urban/platform.
[Unit]
Description=URBAN control centre (platform and interface)
After=network.target urban-prepare.service

[Service]
User=urban
Group=urban
WorkingDirectory=/opt/urban
EnvironmentFile=/var/lib/urban/etc/platform.env
# the env file is data the unit's own user can write: it must not be a way to inject code into the interpreter or
# the loader (python -I below ignores PYTHON* as well)
UnsetEnvironment=PYTHONPATH PYTHONHOME LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH OPENSSL_CONF OPENSSL_MODULES
ExecStart=/opt/urban/.venv/bin/python -I -m urban
Restart=always
RestartSec=3
StandardOutput=journal
# HTTPS on 443 as an unprivileged user: the one capability it has
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# The sandbox: the centre's own data folder and the network. No maintenance keys, no boot files, no devices,
# no other process, no new code in memory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/urban/platform
InaccessiblePaths=-/var/lib/urban/ssh -/var/lib/urban/etc/pki -/var/lib/urban/update -/var/lib/urban/rauc -/boot -/var/lib/urban/wg
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077
