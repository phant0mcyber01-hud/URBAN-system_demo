[Unit]
Description=URBAN OS: data partition, SSH keys, network, identity and role, the role's services
DefaultDependencies=no
RequiresMountsFor=/var/lib/urban /boot/efi
After=local-fs.target
Before=network-pre.target nftables.service systemd-networkd.service ssh.service sysinit.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/urban-prepare
StandardOutput=journal+console

[Install]
WantedBy=sysinit.target
