[Unit]
Description=URBAN OS power: clock and camera work sized to the role, the load and the temperature
After=urban-prepare.service
Wants=urban-prepare.service

[Service]
ExecStart=/opt/urban/.venv/bin/python -m urban.node.power
Restart=always
RestartSec=5
StandardOutput=journal+console
# it writes cpufreq settings, /run/urban/power.json and the screen (urban-console), nothing else
# The sandbox: it writes the CPU's clock settings and its plan, and redraws the screen; it has no network at
# all, no capability, no device, and sees no key.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/sys/devices/system/cpu -/run/urban -/run/agetty.reload
InaccessiblePaths=-/var/lib/urban/ssh -/var/lib/urban/etc/pki -/var/lib/urban/update -/var/lib/urban/rauc -/var/lib/urban/platform -/boot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0022

[Install]
WantedBy=multi-user.target
