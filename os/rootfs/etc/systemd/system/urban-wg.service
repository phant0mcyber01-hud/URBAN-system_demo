# The root helper of the WireGuard tunnel between a junction unit and its district (urban-wg run): it takes the message
# out of the inbox as hostile input, checks it against the anchor it pinned itself, and sets up wg0, its peers, the
# district's relay mode and the unit's camera forwards. Run by urban-wg.path and urban-wg.timer.
#
# Its sandbox: network administration and nothing else of root's power but reading the services' files
# (CAP_DAC_OVERRIDE: the inbox and the gateway certificate belong to user urban, 0700/0750). It writes only its own
# folder, the inbox, /run/urban and the per-interface forwarding switches. No IPAddressDeny/SocketBind (the WireGuard
# socket is made in this unit's cgroup), no ProtectKernelTunables or ProcSubset=pid (they hide or freeze
# /proc/sys/net/ipv4/conf), no PrivateNetwork or PrivateUsers.
[Unit]
Description=URBAN OS: the tunnel to the district, set from the control centre's signed message
After=urban-prepare.service nftables.service systemd-networkd.service
RequiresMountsFor=/var/lib/urban
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/bin/urban-wg run
# 1: a message was refused (said on the console), the rest still done
SuccessExitStatus=1
StandardOutput=journal+console
TimeoutStartSec=120
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/urban -/var/lib/urban/wg -/var/lib/urban/wg-inbox /proc/sys/net/ipv4/conf -/run/agetty.reload
InaccessiblePaths=-/var/lib/urban/ssh -/var/lib/urban/update -/var/lib/urban/update-inbox -/var/lib/urban/rauc -/var/lib/urban/platform -/boot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
KeyringMode=private
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
