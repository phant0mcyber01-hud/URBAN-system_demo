#!/bin/bash
# Every boot, before the network and the services start: the data partition's layout,
# this machine's SSH host key and maintenance keys, a static network if one is configured, its identity and
# role, the firewall openings of that role, and the role's services.
#
# One OS, three roles (urban-unit.txt on the ESP, read once at first boot):
#   unit      a junction's box: makes its key, shows its enrolment code, runs the unit once it has its kit
#             (MODULE=lighting: a street-lighting cabinet, UNIT=light-<cabinet>: the same key and code, and the
#             lighting program instead of the junction's)
#   district  a district's server: its relay carries the junction units' connections to the centre (CENTER=),
#             it reports the queues of the district's cameras to the centre as a device of its own
#   center    the control centre: the platform and its interface over HTTPS
#   district,center   both on one machine (the pilot); its district side is a district of its own, district-<name>:
#             its own key, enrolled at the centre on the same machine by the centre itself (no code typed by anyone),
#             reporting the queues of the machine's cameras to it over the loopback (urban/node/pilot.py)
# A unit with VISION=off is a light unit: no camera work, ever.
# A junction unit (not a lighting cabinet) and a district server also get the WireGuard tunnel between them
# (docs/wireguard-design.md): a key of their own, an inbox for the centre's signed messages, the root helper urban-wg
# and its firewall pieces. The pilot (district,center), a centre and a lighting cabinet get none of it.
set -eu
D=/var/lib/urban
install -d -m 755 "$D" "$D/etc" "$D/rauc"
install -d -m 750 -o urban -g urban "$D/etc/pki" "$D/etc/pki/edge"
install -d -m 700 "$D/ssh"
install -d -m 755 -o root -g root /run/urban  # root's live state (tmpfiles.d/urban.conf says the same)
# this boot's id where the platform can read it (its sandbox hides /proc/sys): the centre's self-update tells the boot
# that handed a release over from the boots after it (backend/urban/self_update.py)
cat /proc/sys/kernel/random/boot_id > /run/urban/boot-id; chmod 644 /run/urban/boot-id
install -d -m 755 -o urban-vision -g urban /run/urban/q  # the only place vision writes: its queue lengths
install -d -m 700 "$D/update"  # update bundles are staged here: the root is read-only, /tmp is small
[ -f "$D/ssh/ssh_host_ed25519_key" ] || ssh-keygen -q -t ed25519 -N '' -f "$D/ssh/ssh_host_ed25519_key" -C urban-edge

# The data partition took the whole disk before it was mounted (urban-grow); its size is said once
if [ ! -f "$D/etc/.grown" ]; then
  touch "$D/etc/.grown"
  echo "URBAN-DATA $(df -m --output=size "$D" | tail -n 1 | tr -d ' ') MiB"
fi

# Maintenance keys the installer put on the ESP (FAT: a Windows laptop can write it), read ONLY before this machine
# has its identity (no unit.conf yet: the very first boot). The ESP is not signed, so after that anyone holding the
# disk could drop a key there and get root over SSH: from then on the file is ignored (logged, renamed). Keys are
# changed afterwards over SSH, in authorized_keys on the data partition. Public keys only, each one checked; they are
# added to the data partition and the file is renamed, so a key removed later over SSH does not come back.
if [ -f /boot/efi/maintenance.pub ] && [ -f "$D/etc/unit.conf" ]; then
  # a FAT error must not stop this script (the role's services would never start): the file is ignored all the same
  mv -f /boot/efi/maintenance.pub /boot/efi/maintenance.pub.ignored \
    || echo "URBAN-MAINTENANCE-KEYS could not rename maintenance.pub to maintenance.pub.ignored on the ESP"
  echo "URBAN-MAINTENANCE-KEYS ignored: the unit already has its identity"
elif [ -f /boot/efi/maintenance.pub ]; then
  touch "$D/ssh/authorized_keys"; chmod 600 "$D/ssh/authorized_keys"
  added=0
  while read -r line; do
    line=${line#$'\xef\xbb\xbf'}  # a BOM from Notepad
    case "$line" in ssh-ed25519\ *|sk-ssh-ed25519@openssh.com\ *|ecdsa-sha2-nistp256\ *|ssh-rsa\ *) ;; *) continue ;; esac
    printf '%s\n' "$line" | ssh-keygen -l -f - >/dev/null 2>&1 || continue
    grep -qxF "$line" "$D/ssh/authorized_keys" || { printf '%s\n' "$line" >> "$D/ssh/authorized_keys"; added=$((added + 1)); }
  done < <(tr -d '\r' < /boot/efi/maintenance.pub; echo)  # the echo: a last line without a newline still counts
  # not renamed: at the next boot the unit has its identity and the file is ignored (the keys are already imported)
  mv -f /boot/efi/maintenance.pub /boot/efi/maintenance.pub.imported \
    || echo "URBAN-MAINTENANCE-KEYS could not rename maintenance.pub to maintenance.pub.imported on the ESP"
  echo "URBAN-MAINTENANCE-KEYS added=$added total=$(grep -c . "$D/ssh/authorized_keys")"
fi

# the static networks (a unit's cabinet network and its link to the district: two cards, or two VLANs whose virtual
# links are *.netdev files), before networkd starts
for f in "$D"/etc/network/*.network "$D"/etc/network/*.netdev; do
  [ -f "$f" ] || continue
  install -d /run/systemd/network
  cp "$f" /run/systemd/network/
done

# KEY=value from the installer's text file on the ESP: CR/LF tolerant, only safe characters, never executed
value() {
  tr -d '\r' < "$2" | sed '1s/^\xEF\xBB\xBF//' | sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\([A-Za-z0-9.,_-]*\)[[:space:]]*$/\1/p" | tail -n 1
}
if [ ! -f "$D/etc/unit.conf" ] && [ -f /boot/efi/urban-unit.txt ]; then
  unit=$(value UNIT /boot/efi/urban-unit.txt)
  serial=$(value SERIAL /boot/efi/urban-unit.txt)
  role=$(value ROLE /boot/efi/urban-unit.txt); role=${role:-unit}
  host=$(value HOST /boot/efi/urban-unit.txt)
  center=$(tr -d '\r' < /boot/efi/urban-unit.txt | sed -n 's/^[[:space:]]*CENTER[[:space:]]*=[[:space:]]*\([A-Za-z0-9.-]*\(:[0-9][0-9]*\)\{0,1\}\)[[:space:]]*$/\1/p' | tail -n 1)
  vision=$(value VISION /boot/efi/urban-unit.txt | tr 'A-Z' 'a-z')
  module=$(value MODULE /boot/efi/urban-unit.txt | tr 'A-Z' 'a-z')
  # a city service other than traffic (the default): only a unit can carry one
  case "$module" in ""|traffic) module="" ;; lighting) ;; *) echo "URBAN-MODULE refused: MODULE=$module (traffic or lighting)"; module=refused ;; esac
  # each role has its own kind of name; the template's placeholder is no name at all
  case "$role" in
    unit) ok='^edge-[A-Za-z0-9._-]+$'; [ "$module" != lighting ] || ok='^light-[A-Za-z0-9._-]+$' ;;
    district) ok='^district-[A-Za-z0-9._-]+$' ;;
    center|district,center|center,district) ok='^center(-[A-Za-z0-9._-]+)?$'; role=${role/center,district/district,center} ;;
    *) ok='^$'; echo "URBAN-ROLE refused: ROLE=$role (unit, district, center or district,center)" ;;
  esac
  if [ "$module" = lighting ] && [ "$role" != unit ]; then
    echo "URBAN-ROLE refused: MODULE=lighting is for a unit (ROLE=unit), not for ROLE=$role"
  elif [ "$module" = refused ]; then
    echo "URBAN-ROLE refused: MODULE in urban-unit.txt is not a known city service"
  elif [ -n "$unit" ] && [[ "$unit" =~ $ok ]] && [ "$unit" != "edge-J-00" ]; then
    case "$center" in ""|*:*) ;; *) center="$center:8443" ;; esac  # the centre's device listener: 8443 unless said
    printf "UNIT=%s\nSERIAL=%s\nROLE=%s\nHOST=%s\nCENTER=%s\n" "$unit" "$serial" "$role" "$host" "$center" > "$D/etc/unit.conf"
    if [ "$role" = unit ] && [ "$module" = lighting ]; then
      { echo "MODULE=lighting"; echo "VISION=off"; } >> "$D/etc/unit.conf"  # a cabinet has no cameras, ever
    elif [ "$role" = unit ] && [ "$vision" = off ]; then
      echo "VISION=off" >> "$D/etc/unit.conf"
    fi
  elif [ -n "$unit" ] && [ "$unit" != "edge-J-00" ]; then
    echo "URBAN-ROLE refused: the name $unit does not fit the role $role (edge-..., light-... with MODULE=lighting, district-..., center...)"
  fi
fi

if [ ! -f "$D/etc/unit.conf" ]; then
  echo "URBAN-ENROLMENT none: this unit has no identity yet. Set UNIT and SERIAL in urban-unit.txt on the URBAN-ESP partition and reboot."
  /usr/local/bin/urban-console
  exit 0
fi
UNIT=$(sed -n 's/^UNIT=//p' "$D/etc/unit.conf")
SERIAL=$(sed -n 's/^SERIAL=//p' "$D/etc/unit.conf")
ROLE=$(sed -n 's/^ROLE=//p' "$D/etc/unit.conf"); ROLE=${ROLE:-unit}  # units set up before roles existed
HOST=$(sed -n 's/^HOST=//p' "$D/etc/unit.conf")
CENTER=$(sed -n 's/^CENTER=//p' "$D/etc/unit.conf")
VISION=$(sed -n 's/^VISION=//p' "$D/etc/unit.conf")
MODULE=$(sed -n 's/^MODULE=//p' "$D/etc/unit.conf")
# the tunnel's two ends: exactly ROLE=unit without MODULE=lighting, or exactly ROLE=district (as urban-wg reads it)
TUNNEL=""
case "$(sed -n 's/^ROLE=//p' "$D/etc/unit.conf" | tail -n 1):$MODULE" in
  unit:lighting) ;;
  unit:*) TUNNEL=unit ;;
  district:*) TUNNEL=district ;;
esac
hostname "$UNIT"  # /etc/hostname is read-only; the name is this machine's own
echo "URBAN-ROLE role=$ROLE name=$UNIT${MODULE:+ module=$MODULE}${VISION:+ vision=$VISION}${CENTER:+ center=$CENTER}"
# the only place the lighting program writes (its state, a screen line): on a lighting cabinet only, so that no
# other machine has a folder its unit service could write to
if [ "$MODULE" = lighting ]; then install -d -m 755 -o urban -g urban /run/urban/light; else rm -rf /run/urban/light; fi

# The inbox for updates the control centre delivers (roles unit and district): the sandboxed client (user urban)
# downloads the package here and writes request.json; urban-update.service (root) takes the package out of it and
# never looks at it before. Nothing else of urban's reaches it. A package staged by an install that never finished
# is removed.
case ",$ROLE," in *,unit,*|*,district,*|*,center,*)  # the centre too: its own self-update (urban-center release self-update)
  install -d -m 700 -o urban -g urban "$D/update-inbox"
  rm -f "$D"/update/ota-*.raucb ;;
esac

# The firewall's role-dependent openings, read by nftables.conf (include /run/urban/nft/*.nft)
install -d /run/urban/nft
: > /run/urban/nft/role.nft
case ",$ROLE," in *,center,*)
  {
    echo 'add rule inet urban input ip saddr $private tcp dport { 443, 8443 } accept comment "control centre: interface (HTTPS), units"'
    echo 'add rule inet urban output tcp dport 443 accept comment "control centre: map data (OpenStreetMap)"'
  } >> /run/urban/nft/role.nft ;;
esac
# a district's relay opens nothing here: urban-relay forwards 8443 from private networks to the centre in the
# kernel (its own nat table and one forward rule), so no port of this machine answers its units at all

# The tunnel's firewall pieces (a junction unit and a district server only). Tunnel addresses (10.77.0.0/16, inside the
# private networks the base rules open) leave only through wg0, whatever route anyone adds; a closed port stays silent
# (no ICMP answer gives a dead tunnel end away); WireGuard's UDP 51820 between the unit and its district. A unit forwards
# only the district's connections to its cameras (DNATed by urban-wg's own table) and their answers. A district takes
# nothing new from the tunnel into itself (its relay's 8443 is DNATed before input, a ping still answers), its units do
# not reach each other through it, and its camera vision (user urban-vision, uid 991) reaches only the cameras' tunnel
# ports and the loopback. The comments name the rules for the checks.
wg_nft_unit() {
  cat <<'EOF'
insert rule inet urban output ip daddr 10.77.0.0/16 oifname != { "wg0", "lo" } counter drop comment "urban-wg: tunnel addresses only through the tunnel"
insert rule inet urban output icmp type destination-unreachable icmp code port-unreachable counter drop comment "urban-wg: closed ports stay silent"
add rule inet urban output udp dport 51820 accept comment "urban-wg: WireGuard to the district"
insert rule inet urban forward ip daddr 10.77.0.0/16 oifname != "wg0" counter drop comment "urban-wg: tunnel addresses only through the tunnel"
add rule inet urban forward iifname "wg0" ct status dnat accept comment "urban-wg: the district to the cabinet cameras"
add rule inet urban forward oifname "wg0" ct state established,related accept comment "urban-wg: the cameras' answers"
EOF
}
wg_nft_district() {
  cat <<'EOF'
insert rule inet urban input iifname "wg0" meta l4proto != icmp ct state new counter drop comment "urban-wg: nothing new from the tunnel into the district itself"
add rule inet urban input udp dport 51820 accept comment "urban-wg: WireGuard from the units"
add rule inet urban output udp sport 51820 accept comment "urban-wg: WireGuard to the units"
insert rule inet urban output ip daddr 10.77.0.0/16 oifname != { "wg0", "lo" } counter drop comment "urban-wg: tunnel addresses only through the tunnel"
insert rule inet urban output icmp type destination-unreachable icmp code port-unreachable counter drop comment "urban-wg: closed ports stay silent"
add chain inet urban wg_vision
add rule inet urban wg_vision oifname "lo" return
add rule inet urban wg_vision oifname "wg0" ip daddr 10.77.0.0/16 tcp dport 8551-8599 return
add rule inet urban wg_vision udp sport 51820 return comment "urban-wg: WireGuard's own packets (the kernel keeps the sender's socket on them)"
add rule inet urban wg_vision counter drop comment "urban-wg: the district's vision reads cameras only through the tunnel"
insert rule inet urban output meta skuid 991 jump wg_vision comment "urban-wg: the district's vision"
insert rule inet urban forward ip daddr 10.77.0.0/16 oifname != "wg0" counter drop comment "urban-wg: tunnel addresses only through the tunnel"
add rule inet urban forward iifname "wg0" oifname "wg0" counter drop comment "urban-wg: units do not reach each other"
EOF
}
case "$TUNNEL" in
  unit) wg_nft_unit > /run/urban/nft/wg.nft && chmod 644 /run/urban/nft/wg.nft || echo "URBAN-WG could not write the firewall pieces" ;;
  district) wg_nft_district > /run/urban/nft/wg.nft && chmod 644 /run/urban/nft/wg.nft || echo "URBAN-WG could not write the firewall pieces" ;;
  *) rm -f /run/urban/nft/wg.nft ;;
esac

# The device key: a unit and a district have a key of their own and enrol with a code; the pilot (district,center) has
# one for its district side, district-<its name>, which its own centre enrols by itself (a centre alone has none)
KEYID=""
OWN=""  # the pilot's own district
case "$ROLE" in
  unit|district) KEYID=$UNIT ;;
  district,center) OWN="district-$UNIT"; KEYID=$OWN ;;
esac
rm -f /run/urban/own-district.code  # (tmpfs: written again below, on the pilot only)
if [ -n "$KEYID" ]; then
  # Made inside the TPM when the machine has one (a folder <id>.tpm of TPM-wrapped blobs that no other machine can
  # use), else an Ed25519 file <id>.key (--tpm auto). Never replaced once there.
  KEY="$D/etc/pki/edge/$KEYID.key"
  TPMKEY="$D/etc/pki/edge/$KEYID.tpm"
  if [ ! -f "$KEY" ] && [ ! -d "$TPMKEY" ]; then
    # the TPM's device node can appear a moment after the data partition (the driver loads, then udev names it): wait
    # for it where the kernel says there is a TPM, so that the key is not made as a file for lack of a few seconds
    if [ -e /sys/class/tpm/tpm0 ]; then
      for _ in $(seq 1 50); do [ -c /dev/tpmrm0 ] && break; sleep 0.2; done
    fi
    /opt/urban/.venv/bin/python -I -m urban.edge --keygen --unit "$KEYID" --serial "$SERIAL" --pki "$D/etc/pki" --tpm auto > "$D/etc/enrolment.txt"
  fi
  # the key folder / file belongs to the service's user alone (urban); the blobs and the file are private to it. Never
  # through a link: the service may write that folder, and root must not change the owner of whatever a link names
  if [ -d "$TPMKEY" ] && [ ! -L "$TPMKEY" ]; then
    chown -R urban:urban "$TPMKEY"
    chmod 700 "$TPMKEY"
    find "$TPMKEY" -type f -exec chmod 600 {} +
  elif [ -f "$KEY" ] && [ ! -L "$KEY" ]; then
    chown urban:urban "$KEY"
    chmod 600 "$KEY"
  fi
  if [ -d "$TPMKEY" ]; then keyin=tpm; else keyin=file; fi
  fingerprint=$(sed -n 's/^fingerprint: *\([0-9A-F-]*\).*/\1/p' "$D/etc/enrolment.txt")
  code=$(grep -o 'URBAN1:[^[:space:]]*' "$D/etc/enrolment.txt" || true)
  echo "URBAN-ENROLMENT unit=$KEYID serial=${SERIAL:--} fingerprint=$fingerprint code=$code key=$keyin${OWN:+ (the district side of this machine: its centre enrols it by itself)}"
  # the pilot: the code (public: its id, serial and public key) for the centre on this machine, which enrols it when it
  # starts; root's file, readable by the centre's service
  if [ -n "$OWN" ] && [ -n "$code" ]; then
    { printf '%s\n' "$code" > /run/urban/own-district.code && chmod 644 /run/urban/own-district.code; } \
      || echo "URBAN-DISTRICT could not hand the code of $OWN to the centre"
  fi
fi
# The tunnel's pieces on the data partition: the inbox the service puts the centre's signed messages in (the service's
# own), and root's folder with the tunnel key (made here once, never replaced: X25519 has no place in the TPM, so it
# is a root-only file, inside LUKS where there is a TPM), the helper's pinned anchor and what it applied. Then the
# helper's boot step: the status the services read, before any of them starts. Nothing here may stop this script.
if [ -n "$TUNNEL" ]; then
  install -d -m 700 -o urban -g urban "$D/wg-inbox" || echo "URBAN-WG could not make the inbox"
  install -d -m 700 -o root -g root "$D/wg" "$D/wg/trust" || echo "URBAN-WG could not make its folder"
  if [ ! -s "$D/wg/key.pub" ]; then
    { if [ -f "$D/wg/key" ]; then /opt/urban/.venv/bin/python -I -m urban.net.wireguard pubkey "$D/wg/key";
      else /opt/urban/.venv/bin/python -I -m urban.net.wireguard keygen "$D/wg/key"; fi; } > "$D/wg/key.pub.tmp" \
      && chmod 644 "$D/wg/key.pub.tmp" && mv -f "$D/wg/key.pub.tmp" "$D/wg/key.pub" || echo "URBAN-WG key could not be made"
  fi
  # fingerprint in bash (no Python): sha256 of the 32 raw bytes, first 16 hex, upper case, 4-4-4-4 (= wireguard.fingerprint)
  wgpub=$(head -n 1 "$D/wg/key.pub" 2>/dev/null || true)
  wgfp=none
  if [ -n "$wgpub" ]; then
    wgfp=$(printf '%s' "$wgpub" | base64 -d 2>/dev/null | sha256sum | cut -c1-16 | tr 'a-f' 'A-F' \
      | sed 's/^\(....\)\(....\)\(....\)\(....\)$/\1-\2-\3-\4/' || true)
  fi
  echo "URBAN-WG key fingerprint=${wgfp:-none}"
  /usr/local/bin/urban-wg boot || echo "URBAN-WG boot failed"
fi
/usr/local/bin/urban-console  # the same, on the machine's own screen

# The pilot's own district: its kit, as `urban-unit setup` puts a district's kit in place, made by the centre's own
# command from the code above (urban-center provision own-kit: the centre's CA and root key, this key's fingerprint, the
# centre's name on its certificate) and pointed at the centre over the loopback. Run before the centre starts: on the
# very first boot the command makes the centre's keys and certificate as the centre would (the same provisioning, as
# its user), so the two never race. At later boots nothing is redone while the kit still matches the centre's CA, root
# key, name and port.
own_district_kit() {
  local env="$D/etc/edge-$OWN.env" pki="$D/platform/pki" name port kit
  name=$(sed -n 's/^DEVICE_NAME=//p' "$D/etc/platform.env" | tail -n 1); name=${name:-localhost}
  port=$(sed -n 's/^DEVICE_PORT=//p' "$D/etc/platform.env" | tail -n 1); port=${port:-8443}
  # (compared as text: the kit writes root.pub with a final newline, the centre's has none)
  if [ -f "$env" ] && [ -s "$pki/ca.pem" ] && [ "$(cat "$pki/ca.pem")" = "$(cat "$D/etc/pki/ca.pem" 2>/dev/null)" ] \
      && [ -s "$pki/root.pub" ] && [ "$(cat "$pki/root.pub")" = "$(cat "$D/etc/pki/root.pub" 2>/dev/null)" ] \
      && grep -qx "SERVER_NAME=$name" "$env" && grep -qx "PLATFORM=127.0.0.1:$port" "$env"; then
    return 0
  fi
  kit=$(mktemp /run/urban/own-kit.XXXXXX)
  chmod 644 "$kit"  # public (the centre's CA and keys' public halves); the command writes it as the centre's user
  if ! /usr/local/bin/urban-center provision own-kit --code /run/urban/own-district.code > "$kit"; then
    rm -f "$kit"; echo "URBAN-DISTRICT the kit of $OWN could not be made"; return 1
  fi
  if ! /opt/urban/.venv/bin/python -I -m urban.edge --setup "$kit" --unit "$OWN" --pki /etc/urban/pki --env "$env" > /dev/null; then
    rm -f "$kit"; echo "URBAN-DISTRICT the kit of $OWN could not be put in place"; return 1
  fi
  rm -f "$kit"
  chown -R urban:urban "$D/etc/pki"
  grep -q '^UPDATES=' "$env" || printf '%s\n' "# this machine's system is the centre's: updated by urban-center release self-update, never by an offer" \
    "UPDATES=off" >> "$env"
  echo "URBAN-DISTRICT kit of $OWN in place: to the centre over the loopback 127.0.0.1:$port (certificate of $name)"
}

# The role's services. They cannot be "enabled" (that writes into the read-only /etc), so they are started
# from here; --no-block: they wait for the network on their own.
case ",$ROLE," in *,center,*)
  install -d -m 750 -o urban -g urban "$D/platform" "$D/platform/city"
  if [ ! -f "$D/etc/platform.env" ]; then
    {
      echo "# The control centre on URBAN OS (urban-platform.service). Edit over SSH, then: systemctl restart urban-platform"
      echo "URBAN_SOURCE=field"
      echo "HOST=0.0.0.0"
      echo "PORT=443"
      echo "UI_TLS=on"
      echo "DEVICE_HOST=0.0.0.0"
      echo "DEVICE_PORT=8443"
      echo "# the name (or address) units and operators use for this machine; it goes on the server certificate"
      echo "DEVICE_NAME=${HOST:-$UNIT}"
    } > "$D/etc/platform.env"
    chmod 640 "$D/etc/platform.env"; chgrp urban "$D/etc/platform.env"
  fi
  if [ -n "$OWN" ] && [ -f /run/urban/own-district.code ]; then own_district_kit || OWN=""; else OWN=""; fi
  systemctl start --no-block urban-platform.service
  echo "URBAN-SERVICE starting the control centre (https://${HOST:-$UNIT}/)" ;;
esac
case ",$ROLE," in *,district,*)
  if [ -f "$D/etc/cameras.json" ]; then systemctl start --no-block "urban-vision@$UNIT.service"; fi
  if [ "$ROLE" = district ] && [ -n "$CENTER" ]; then  # the relay (the pilot's centre is on this very machine: no relay)
    echo "CENTER=$CENTER" > /run/urban/relay.env
    systemctl start --no-block urban-relay.service
    echo "URBAN-RELAY units -> $CENTER (kernel forwarding)"
  elif [ "$ROLE" = district ]; then
    echo "URBAN-RELAY not started: no CENTER= in urban-unit.txt"
  fi
  if [ "$ROLE" = district ] && [ -f "$D/etc/edge-$UNIT.env" ]; then  # its own link to the centre, once its kit is in place
    systemctl start --no-block "urban-district@$UNIT.service"
    echo "URBAN-DISTRICT starting urban-district@$UNIT"
  elif [ -n "$OWN" ] && [ -f "$D/etc/edge-$OWN.env" ]; then  # the pilot's own district, to the centre on this machine
    systemctl start --no-block "urban-district@$OWN.service"
    echo "URBAN-DISTRICT starting urban-district@$OWN (this machine's own district, to its centre over the loopback)"
  fi ;;
esac
if [ "$ROLE" = unit ] && [ "$MODULE" = lighting ]; then
  # a street-lighting cabinet: its own program (obeys the centre's signed commands, otherwise its schedule), no
  # junction controller and no cameras. The screen line is redrawn from its state by urban-lighting-screen.timer.
  if [ -f "$D/etc/edge-$UNIT.env" ]; then
    systemctl start --no-block "urban-lighting@$UNIT.service"
    echo "URBAN-LIGHTING starting urban-lighting@$UNIT"
  fi
  systemctl start --no-block urban-lighting-screen.timer
elif [ "$ROLE" = unit ] && [ -f "$D/etc/edge-$UNIT.env" ]; then
  systemctl start --no-block "urban-edge@$UNIT.service"
  if [ -f "$D/etc/cameras.json" ] && [ "$VISION" != off ]; then systemctl start --no-block "urban-vision@$UNIT.service"; fi
  echo "URBAN-UNIT starting urban-edge@$UNIT${VISION:+ (light: no vision)}"
fi
# the root helper for those updates waits for the client's request (a path unit: it cannot be "enabled" either)
case ",$ROLE," in *,unit,*|*,district,*|*,center,*) systemctl start --no-block urban-update.path ;; esac
# the tunnel's root helper: at once when the service has put a message in the inbox, and every 30 s (the clock, the
# handshake, a firewall reload, a silent peer)
if [ -n "$TUNNEL" ]; then
  systemctl start --no-block urban-wg.path urban-wg.timer || echo "URBAN-WG the tunnel helper could not be started"
fi
