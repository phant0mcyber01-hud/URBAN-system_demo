#!/bin/bash
# Every boot, before the network and the services start: the data partition's layout,
# this machine's SSH host key and maintenance keys, a static network if one is configured, its identity and
# role, the firewall openings of that role, and the role's services.
#
# One OS, three roles (urban-unit.txt on the ESP, read once at first boot):
#   unit      a junction's box: makes its key, shows its enrolment code, runs the unit once it has its kit
#             (MODULE=lighting: a street-lighting cabinet, UNIT=light-<cabinet>: the same key and code, and the
#             lighting program instead of the junction's)
#   district  a district's server: its relay carries the junction units' connections to the centre (CENTER=),
#             it reports the queues of the district's cameras to the centre as a device of its own
#   center    the control centre: the platform and its interface over HTTPS
#   district,center   both on one machine (the pilot)
# A unit with VISION=off is a light unit: no camera work, ever.
set -eu
D=/var/lib/urban
install -d -m 755 "$D" "$D/etc" "$D/rauc"
install -d -m 750 -o urban -g urban "$D/etc/pki" "$D/etc/pki/edge"
install -d -m 700 "$D/ssh"
install -d -m 755 -o root -g root /run/urban  # root's live state (tmpfiles.d/urban.conf says the same)
install -d -m 755 -o urban-vision -g urban /run/urban/q  # the only place vision writes: its queue lengths
install -d -m 700 "$D/update"  # update bundles are staged here: the root is read-only, /tmp is small
[ -f "$D/ssh/ssh_host_ed25519_key" ] || ssh-keygen -q -t ed25519 -N '' -f "$D/ssh/ssh_host_ed25519_key" -C urban-edge

# The data partition took the whole disk before it was mounted (urban-grow); its size is said once
if [ ! -f "$D/etc/.grown" ]; then
  touch "$D/etc/.grown"
  echo "URBAN-DATA $(df -m --output=size "$D" | tail -n 1 | tr -d ' ') MiB"
fi

# Maintenance keys the installer put on the ESP (FAT: a Windows laptop can write it), read ONLY before this machine
# has its identity (no unit.conf yet: the very first boot). The ESP is not signed, so after that anyone holding the
# disk could drop a key there and get root over SSH: from then on the file is ignored (logged, renamed). Keys are
# changed afterwards over SSH, in authorized_keys on the data partition. Public keys only, each one checked; they are
# added to the data partition and the file is renamed, so a key removed later over SSH does not come back.
if [ -f /boot/efi/maintenance.pub ] && [ -f "$D/etc/unit.conf" ]; then
  # a FAT error must not stop this script (the role's services would never start): the file is ignored all the same
  mv -f /boot/efi/maintenance.pub /boot/efi/maintenance.pub.ignored \
    || echo "URBAN-MAINTENANCE-KEYS could not rename maintenance.pub to maintenance.pub.ignored on the ESP"
  echo "URBAN-MAINTENANCE-KEYS ignored: the unit already has its identity"
elif [ -f /boot/efi/maintenance.pub ]; then
  touch "$D/ssh/authorized_keys"; chmod 600 "$D/ssh/authorized_keys"
  added=0
  while read -r line; do
    line=${line#$'\xef\xbb\xbf'}  # a BOM from Notepad
    case "$line" in ssh-ed25519\ *|sk-ssh-ed25519@openssh.com\ *|ecdsa-sha2-nistp256\ *|ssh-rsa\ *) ;; *) continue ;; esac
    printf '%s\n' "$line" | ssh-keygen -l -f - >/dev/null 2>&1 || continue
    grep -qxF "$line" "$D/ssh/authorized_keys" || { printf '%s\n' "$line" >> "$D/ssh/authorized_keys"; added=$((added + 1)); }
  done < <(tr -d '\r' < /boot/efi/maintenance.pub; echo)  # the echo: a last line without a newline still counts
  # not renamed: at the next boot the unit has its identity and the file is ignored (the keys are already imported)
  mv -f /boot/efi/maintenance.pub /boot/efi/maintenance.pub.imported \
    || echo "URBAN-MAINTENANCE-KEYS could not rename maintenance.pub to maintenance.pub.imported on the ESP"
  echo "URBAN-MAINTENANCE-KEYS added=$added total=$(grep -c . "$D/ssh/authorized_keys")"
fi

if compgen -G "$D/etc/network/*.network" >/dev/null; then
  install -d /run/systemd/network
  cp "$D"/etc/network/*.network /run/systemd/network/
fi

# KEY=value from the installer's text file on the ESP: CR/LF tolerant, only safe characters, never executed
value() {
  tr -d '\r' < "$2" | sed '1s/^\xEF\xBB\xBF//' | sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\([A-Za-z0-9.,_-]*\)[[:space:]]*$/\1/p" | tail -n 1
}
if [ ! -f "$D/etc/unit.conf" ] && [ -f /boot/efi/urban-unit.txt ]; then
  unit=$(value UNIT /boot/efi/urban-unit.txt)
  serial=$(value SERIAL /boot/efi/urban-unit.txt)
  role=$(value ROLE /boot/efi/urban-unit.txt); role=${role:-unit}
  host=$(value HOST /boot/efi/urban-unit.txt)
  center=$(tr -d '\r' < /boot/efi/urban-unit.txt | sed -n 's/^[[:space:]]*CENTER[[:space:]]*=[[:space:]]*\([A-Za-z0-9.-]*\(:[0-9][0-9]*\)\{0,1\}\)[[:space:]]*$/\1/p' | tail -n 1)
  vision=$(value VISION /boot/efi/urban-unit.txt | tr 'A-Z' 'a-z')
  module=$(value MODULE /boot/efi/urban-unit.txt | tr 'A-Z' 'a-z')
  # a city service other than traffic (the default): only a unit can carry one
  case "$module" in ""|traffic) module="" ;; lighting) ;; *) echo "URBAN-MODULE refused: MODULE=$module (traffic or lighting)"; module=refused ;; esac
  # each role has its own kind of name; the template's placeholder is no name at all
  case "$role" in
    unit) ok='^edge-[A-Za-z0-9._-]+$'; [ "$module" != lighting ] || ok='^light-[A-Za-z0-9._-]+$' ;;
    district) ok='^district-[A-Za-z0-9._-]+$' ;;
    center|district,center|center,district) ok='^center(-[A-Za-z0-9._-]+)?$'; role=${role/center,district/district,center} ;;
    *) ok='^$'; echo "URBAN-ROLE refused: ROLE=$role (unit, district, center or district,center)" ;;
  esac
  if [ "$module" = lighting ] && [ "$role" != unit ]; then
    echo "URBAN-ROLE refused: MODULE=lighting is for a unit (ROLE=unit), not for ROLE=$role"
  elif [ "$module" = refused ]; then
    echo "URBAN-ROLE refused: MODULE in urban-unit.txt is not a known city service"
  elif [ -n "$unit" ] && [[ "$unit" =~ $ok ]] && [ "$unit" != "edge-J-00" ]; then
    case "$center" in ""|*:*) ;; *) center="$center:8443" ;; esac  # the centre's device listener: 8443 unless said
    printf "UNIT=%s\nSERIAL=%s\nROLE=%s\nHOST=%s\nCENTER=%s\n" "$unit" "$serial" "$role" "$host" "$center" > "$D/etc/unit.conf"
    if [ "$role" = unit ] && [ "$module" = lighting ]; then
      { echo "MODULE=lighting"; echo "VISION=off"; } >> "$D/etc/unit.conf"  # a cabinet has no cameras, ever
    elif [ "$role" = unit ] && [ "$vision" = off ]; then
      echo "VISION=off" >> "$D/etc/unit.conf"
    fi
  elif [ -n "$unit" ] && [ "$unit" != "edge-J-00" ]; then
    echo "URBAN-ROLE refused: the name $unit does not fit the role $role (edge-..., light-... with MODULE=lighting, district-..., center...)"
  fi
fi

if [ ! -f "$D/etc/unit.conf" ]; then
  echo "URBAN-ENROLMENT none: this unit has no identity yet. Set UNIT and SERIAL in urban-unit.txt on the URBAN-ESP partition and reboot."
  /usr/local/bin/urban-console
  exit 0
fi
UNIT=$(sed -n 's/^UNIT=//p' "$D/etc/unit.conf")
SERIAL=$(sed -n 's/^SERIAL=//p' "$D/etc/unit.conf")
ROLE=$(sed -n 's/^ROLE=//p' "$D/etc/unit.conf"); ROLE=${ROLE:-unit}  # units set up before roles existed
HOST=$(sed -n 's/^HOST=//p' "$D/etc/unit.conf")
CENTER=$(sed -n 's/^CENTER=//p' "$D/etc/unit.conf")
VISION=$(sed -n 's/^VISION=//p' "$D/etc/unit.conf")
MODULE=$(sed -n 's/^MODULE=//p' "$D/etc/unit.conf")
hostname "$UNIT"  # /etc/hostname is read-only; the name is this machine's own
echo "URBAN-ROLE role=$ROLE name=$UNIT${MODULE:+ module=$MODULE}${VISION:+ vision=$VISION}${CENTER:+ center=$CENTER}"
# the only place the lighting program writes (its state, a screen line): on a lighting cabinet only, so that no
# other machine has a folder its unit service could write to
if [ "$MODULE" = lighting ]; then install -d -m 755 -o urban -g urban /run/urban/light; else rm -rf /run/urban/light; fi

# The inbox for updates the control centre delivers (roles unit and district): the sandboxed client (user urban)
# downloads the package here and writes request.json; urban-update.service (root) takes the package out of it and
# never looks at it before. Nothing else of urban's reaches it. A package staged by an install that never finished
# is removed.
case ",$ROLE," in *,unit,*|*,district,*)
  install -d -m 700 -o urban -g urban "$D/update-inbox"
  rm -f "$D"/update/ota-*.raucb ;;
esac

# The firewall's role-dependent openings, read by nftables.conf (include /run/urban/nft/*.nft)
install -d /run/urban/nft
: > /run/urban/nft/role.nft
case ",$ROLE," in *,center,*)
  {
    echo 'add rule inet urban input ip saddr $private tcp dport { 443, 8443 } accept comment "control centre: interface (HTTPS), units"'
    echo 'add rule inet urban output tcp dport 443 accept comment "control centre: map data (OpenStreetMap)"'
  } >> /run/urban/nft/role.nft ;;
esac
# a district's relay opens nothing here: urban-relay forwards 8443 from private networks to the centre in the
# kernel (its own nat table and one forward rule), so no port of this machine answers its units at all

case "$ROLE" in unit|district)  # a unit and a district have a key of their own and enrol with a code (the pilot's centre has neither)
  # The device key: made inside the TPM when the machine has one (a folder <unit>.tpm of TPM-wrapped blobs that no
  # other machine can use), else an Ed25519 file <unit>.key (--tpm auto). Never replaced once there.
  KEY="$D/etc/pki/edge/$UNIT.key"
  TPMKEY="$D/etc/pki/edge/$UNIT.tpm"
  if [ ! -f "$KEY" ] && [ ! -d "$TPMKEY" ]; then
    # the TPM's device node can appear a moment after the data partition (the driver loads, then udev names it): wait
    # for it where the kernel says there is a TPM, so that the key is not made as a file for lack of a few seconds
    if [ -e /sys/class/tpm/tpm0 ]; then
      for _ in $(seq 1 50); do [ -c /dev/tpmrm0 ] && break; sleep 0.2; done
    fi
    /opt/urban/.venv/bin/python -I -m urban.edge --keygen --unit "$UNIT" --serial "$SERIAL" --pki "$D/etc/pki" --tpm auto > "$D/etc/enrolment.txt"
  fi
  # the key folder / file belongs to the service's user alone (urban); the blobs and the file are private to it
  if [ -d "$TPMKEY" ]; then
    chown -R urban:urban "$TPMKEY"
    chmod 700 "$TPMKEY"
    find "$TPMKEY" -type f -exec chmod 600 {} +
  elif [ -f "$KEY" ]; then
    chown urban:urban "$KEY"
    chmod 600 "$KEY"
  fi
  if [ -d "$TPMKEY" ]; then keyin=tpm; else keyin=file; fi
  fingerprint=$(sed -n 's/^fingerprint: *\([0-9A-F-]*\).*/\1/p' "$D/etc/enrolment.txt")
  code=$(grep -o 'URBAN1:[^[:space:]]*' "$D/etc/enrolment.txt" || true)
  echo "URBAN-ENROLMENT unit=$UNIT serial=${SERIAL:--} fingerprint=$fingerprint code=$code key=$keyin" ;;
esac
/usr/local/bin/urban-console  # the same, on the machine's own screen

# The role's services. They cannot be "enabled" (that writes into the read-only /etc), so they are started
# from here; --no-block: they wait for the network on their own.
case ",$ROLE," in *,center,*)
  install -d -m 750 -o urban -g urban "$D/platform" "$D/platform/city"
  if [ ! -f "$D/etc/platform.env" ]; then
    {
      echo "# The control centre on URBAN OS (urban-platform.service). Edit over SSH, then: systemctl restart urban-platform"
      echo "URBAN_SOURCE=field"
      echo "HOST=0.0.0.0"
      echo "PORT=443"
      echo "UI_TLS=on"
      echo "DEVICE_HOST=0.0.0.0"
      echo "DEVICE_PORT=8443"
      echo "# the name (or address) units and operators use for this machine; it goes on the server certificate"
      echo "DEVICE_NAME=${HOST:-$UNIT}"
    } > "$D/etc/platform.env"
    chmod 640 "$D/etc/platform.env"; chgrp urban "$D/etc/platform.env"
  fi
  systemctl start --no-block urban-platform.service
  echo "URBAN-SERVICE starting the control centre (https://${HOST:-$UNIT}/)" ;;
esac
case ",$ROLE," in *,district,*)
  if [ -f "$D/etc/cameras.json" ]; then systemctl start --no-block "urban-vision@$UNIT.service"; fi
  if [ "$ROLE" = district ] && [ -n "$CENTER" ]; then  # the relay (the pilot's centre is on this very machine: no relay)
    echo "CENTER=$CENTER" > /run/urban/relay.env
    systemctl start --no-block urban-relay.service
    echo "URBAN-RELAY units -> $CENTER (kernel forwarding)"
  elif [ "$ROLE" = district ]; then
    echo "URBAN-RELAY not started: no CENTER= in urban-unit.txt"
  fi
  if [ -f "$D/etc/edge-$UNIT.env" ]; then  # its own link to the centre, once the district's kit is in place
    systemctl start --no-block "urban-district@$UNIT.service"
    echo "URBAN-DISTRICT starting urban-district@$UNIT"
  fi ;;
esac
if [ "$ROLE" = unit ] && [ "$MODULE" = lighting ]; then
  # a street-lighting cabinet: its own program (obeys the centre's signed commands, otherwise its schedule), no
  # junction controller and no cameras. The screen line is redrawn from its state by urban-lighting-screen.timer.
  if [ -f "$D/etc/edge-$UNIT.env" ]; then
    systemctl start --no-block "urban-lighting@$UNIT.service"
    echo "URBAN-LIGHTING starting urban-lighting@$UNIT"
  fi
  systemctl start --no-block urban-lighting-screen.timer
elif [ "$ROLE" = unit ] && [ -f "$D/etc/edge-$UNIT.env" ]; then
  systemctl start --no-block "urban-edge@$UNIT.service"
  if [ -f "$D/etc/cameras.json" ] && [ "$VISION" != off ]; then systemctl start --no-block "urban-vision@$UNIT.service"; fi
  echo "URBAN-UNIT starting urban-edge@$UNIT${VISION:+ (light: no vision)}"
fi
# the root helper for those updates waits for the client's request (a path unit: it cannot be "enabled" either)
case ",$ROLE," in *,unit,*|*,district,*) systemctl start --no-block urban-update.path ;; esac
