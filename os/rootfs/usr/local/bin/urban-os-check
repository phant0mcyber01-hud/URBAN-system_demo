#!/bin/bash
# The OS checks its own promises and says so in one line: URBAN-OS-CHECK OK ... or URBAN-OS-CHECK FAIL ...
# Run at every boot (urban-os-check.service); urban-health decides from it whether this slot is good.
fail=()
warn=()
version=$(sed -n 's/^VERSION=//p' /etc/urban-os-release)
slot=$(sed -n 's/.*rauc\.slot=\([AB]\).*/\1/p' /proc/cmdline)
[ -n "$slot" ] || fail+=("no slot on the kernel command line")

read -r fstype opts < <(findmnt -n -o FSTYPE,OPTIONS /)
if [ "$fstype" != squashfs ] || [[ ",$opts," != *,ro,* ]]; then fail+=("root is not a read-only squashfs ($fstype $opts)"); fi
if touch /usr/.urban-write-test 2>/dev/null; then rm -f /usr/.urban-write-test; fail+=("root accepted a write"); fi

dopts=$(findmnt -n -o OPTIONS /var/lib/urban 2>/dev/null)
[[ ",$dopts," == *,rw,* ]] || fail+=("data partition not mounted read-write")
dsrc=$(findmnt -n -o SOURCE /var/lib/urban 2>/dev/null)
crypt=plain
if [ "$dsrc" = /dev/mapper/urban-data ] && cryptsetup status urban-data 2>/dev/null | grep -q 'type: *LUKS2'; then
  crypt=luks2-tpm2
elif [ -c /dev/tpmrm0 ]; then
  warn+=("a TPM but the data partition is plain")  # an update cannot fix this; it must not cause a rollback
fi

if systemctl is-active --quiet nftables && nft list table inet urban >/dev/null 2>&1; then
  nft list chain inet urban input | grep -q 'policy drop' || fail+=("firewall input policy is not drop")
else
  fail+=("firewall not loaded")
fi

# The signed boot chain, reported and never failed on: a machine whose firmware has not been given the URBAN keys (Secure
# Boot off) must still run, the screen says plainly that it does. Secure Boot: the last byte of the firmware variable.
# Verity: the root is the dm-verity device the initramfs opened from the slot's signed root hash.
sb=off
sbvar=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
if [ -r "$sbvar" ] && [ "$(tail -c1 "$sbvar" 2>/dev/null | od -An -tu1 | tr -d ' ')" = 1 ]; then sb=on; fi
# a warning, not a failure: with Secure Boot off the firmware runs any boot loader on the ESP, which an update cannot fix
[ "$sb" = on ] || warn+=("secure boot is off")
verity=off
rootdev=$(findmnt -n -o SOURCE / 2>/dev/null)
if grep -q ' urban\.verity=' /proc/cmdline && [ -b /dev/mapper/urban-root ] && [ -n "$rootdev" ] \
   && [ "$(readlink -f "$rootdev")" = "$(readlink -f /dev/mapper/urban-root)" ] \
   && veritysetup status urban-root 2>/dev/null | grep -qi 'type: *VERITY'; then
  verity=on
fi

wd=$(systemctl show -p RuntimeWatchdogUSec --value)
if [ ! -e /dev/watchdog0 ] || [ -z "$wd" ] || [ "$wd" = 0 ] || [ "$wd" = infinity ]; then fail+=("watchdog not armed ($wd)"); fi

sshd -T 2>/dev/null | grep -qx 'passwordauthentication no' || fail+=("SSH accepts passwords")
passwd -S root | grep -q ' L ' || fail+=("root has a usable password")

systemctl is-active --quiet urban-prepare || fail+=("urban-prepare failed")
unit=$(sed -n 's/^UNIT=//p' /var/lib/urban/etc/unit.conf 2>/dev/null)
role=$(sed -n 's/^ROLE=//p' /var/lib/urban/etc/unit.conf 2>/dev/null); role=${role:-unit}
module=$(sed -n 's/^MODULE=//p' /var/lib/urban/etc/unit.conf 2>/dev/null)  # lighting: a street-lighting cabinet
if [ -z "$unit" ]; then
  unit=none
elif [ "$role" = unit ]; then
  { [ -f "/var/lib/urban/etc/pki/edge/$unit.key" ] || [ -d "/var/lib/urban/etc/pki/edge/$unit.tpm" ]; } || fail+=("unit $unit has no key")
fi
# The URBAN software: where its service is meant to run, the proof is that it runs and stays up (a broken update
# shows here and is rolled back); elsewhere every module must at least be found (no execution, no import cost:
# the full import used to be the most expensive thing this machine did at boot).
python_ok() {
  /opt/urban/.venv/bin/python -I -c "import importlib.util as u, sys; sys.exit(any(u.find_spec(m) is None for m in sys.argv[1:]))" "$@" 2>/dev/null
}
stays_up() {  # the unit active now, and the same process five seconds later
  local i pid
  for i in $(seq 1 60); do systemctl is-active --quiet "$1" && break; sleep 1; done
  pid=$(systemctl show -p MainPID --value "$1"); sleep 5
  systemctl is-active --quiet "$1" && [ "$pid" != 0 ] && [ "$(systemctl show -p MainPID --value "$1")" = "$pid" ]
}
# A service that does not stay up: the image's fault when Python itself breaks (a bad update), not when the unit
# refuses its controller or its centre (configuration: a rollback would not help and would go on forever).
service_check() {  # $1 unit, $2 what
  stays_up "$1" && return 0
  if journalctl -u "$1" -b --no-pager -o cat 2>/dev/null | grep -qE 'ModuleNotFoundError|ImportError|SyntaxError'; then
    fail+=("$2 does not start: the software is broken")
  else
    warn+=("$2 does not stay up (see journalctl -u $1)")
  fi
}
python_ok urban.edge.__main__ urban.node.power urban.node.district urban.platform urban.devices.signer || fail+=("URBAN software does not start")
systemctl cat urban-edge@check.service >/dev/null 2>&1 || fail+=("urban-edge@ service missing")
systemctl cat urban-lighting@check.service urban-lighting-screen.timer urban-lighting-screen.service >/dev/null 2>&1 || fail+=("lighting services missing")
systemctl cat urban-relay.service urban-district@check.service >/dev/null 2>&1 || fail+=("district services missing")
if [ "$role" = district ]; then
  { [ -f "/var/lib/urban/etc/pki/edge/$unit.key" ] || [ -d "/var/lib/urban/etc/pki/edge/$unit.tpm" ]; } || fail+=("district $unit has no key")
fi
# updates delivered by the control centre: the helper's units are in the image; where a client exists (a unit or a
# district with an identity) the path unit waits for its request and the inbox is the client's
# a key made in the TPM is only usable through tpm2-tools: an image without them (a bad update) must not stay
if [ "$unit" != none ] && [ -d "/var/lib/urban/etc/pki/edge/$unit.tpm" ]; then
  for t in tpm2_createprimary tpm2_load tpm2_sign; do command -v "$t" >/dev/null || { fail+=("the TPM key of $unit needs $t (tpm2-tools)"); break; }; done
fi
systemctl cat urban-update.path urban-update.service >/dev/null 2>&1 || fail+=("update helper units missing")
case ",$role," in *,unit,*|*,district,*)
  if [ "$unit" != none ]; then
    for i in $(seq 1 10); do systemctl is-active --quiet urban-update.path && break; sleep 1; done
    systemctl is-active --quiet urban-update.path || warn+=("the update helper is not waiting for requests")
    [ "$(stat -c %U:%a /var/lib/urban/update-inbox 2>/dev/null)" = urban:700 ] || warn+=("the update inbox is missing")
  fi ;;
esac
if [ "$role" = unit ] && [ "$module" = lighting ]; then
  # a street-lighting cabinet runs its lighting program instead of the junction unit (and has no cameras)
  python_ok urban.modules.lighting.__main__ || fail+=("the lighting software does not start")
  if [ -f "/var/lib/urban/etc/edge-$unit.env" ]; then
    service_check "urban-lighting@$unit.service" "the cabinet service urban-lighting@$unit"
  fi
elif [ "$role" = unit ] && [ -f "/var/lib/urban/etc/edge-$unit.env" ]; then
  service_check "urban-edge@$unit.service" "the unit service urban-edge@$unit"
fi
case ",$role," in *,center,*)
  python_ok fastapi uvicorn || fail+=("the control centre's software is broken")
  service_check urban-platform.service "the control centre urban-platform"
  [ -f /opt/urban/web/dist/index.html ] || fail+=("the control centre's interface is missing") ;;
esac

install -d /run/urban
if [ ${#fail[@]} -eq 0 ]; then
  note=""; [ ${#warn[@]} -gt 0 ] && note=" warn=$(IFS=';'; echo "${warn[*]}" | tr ' ' '_')"
  echo "URBAN-OS-CHECK OK version=$version slot=$slot root=ro data=rw,$crypt firewall=on watchdog=$wd secureboot=$sb verity=$verity unit=$unit role=$role${module:+ module=$module}$note"
  echo "OK - read-only system, data writable, firewall on, watchdog $wd${warn:+; WARNING: $(IFS=';'; echo "${warn[*]}")}" > /run/urban/os-check
  echo "$crypt" > /run/urban/data-crypt
  echo "secureboot=$sb verity=$verity" > /run/urban/boot-state
  /usr/local/bin/urban-console
  exit 0
fi
echo "secureboot=$sb verity=$verity" > /run/urban/boot-state
echo "URBAN-OS-CHECK FAIL version=$version slot=$slot: $(IFS=';'; echo "${fail[*]}") (secureboot=$sb verity=$verity)"
echo "FAILED - $(IFS=';'; echo "${fail[*]}")" > /run/urban/os-check
/usr/local/bin/urban-console
exit 1
