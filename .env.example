# bbox: west,south,east,north (~2.3 x 2.9 km around the centre of Fergana)
BBOX=71.770,40.372,71.800,40.398
# simulation
SIM_SPEEDUP=1
SIM_END=3600
CAR_PERIOD=0.6
BUS_PERIOD=120
INCIDENT_AT=120
INCIDENT_DURATION=240
PORT=8080
# roles that must use one-time codes (TOTP) to get their rights, e.g. operator,admin; empty = optional
MFA_ROLES=
# copy of the audit log outside this machine: a file on another disk and/or a syslog collector (udp:// or tcp://)
# green corridor proposals for emergency units (on/off); off: no clear benefit measured, docs/corridor.md
GREEN_CORRIDOR=off
AUDIT_EXPORT=
AUDIT_SYSLOG=
# field: the real system (default). simulation: the demo twin, same as `python -m urban --demo`
URBAN_SOURCE=field
